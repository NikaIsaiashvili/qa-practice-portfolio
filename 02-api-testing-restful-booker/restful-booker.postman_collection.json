{
  "info": {
    "name": "Restful-Booker API tests",
    "description": "Practice API tests for https://restful-booker.herokuapp.com (public practice API). Run the folders in order. Folder 3 needs the username and password from the API documentation, entered in the environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health and read",
      "item": [
        {
          "name": "API-01 Health check returns 201",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/ping"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 (as documented)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "API-02 Get all booking IDs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/booking",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response is a non-empty array', () => { pm.expect(body).to.be.an('array').that.is.not.empty; });",
                  "pm.test('Each item has a numeric bookingid', () => { body.forEach(b => pm.expect(b.bookingid).to.be.a('number')); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Create and read booking (no auth)",
      "item": [
        {
          "name": "API-03 Create booking with valid data",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/booking",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"QaTest\",\n  \"lastname\": \"Practice\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": { \"checkin\": \"2026-11-01\", \"checkout\": \"2026-11-05\" },\n  \"additionalneeds\": \"Breakfast\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('bookingid is a number', () => pm.expect(body.bookingid).to.be.a('number'));",
                  "pm.test('Response echoes the sent data', () => {",
                  "  pm.expect(body.booking.firstname).to.eql('QaTest');",
                  "  pm.expect(body.booking.lastname).to.eql('Practice');",
                  "  pm.expect(body.booking.totalprice).to.eql(150);",
                  "  pm.expect(body.booking.depositpaid).to.eql(true);",
                  "  pm.expect(body.booking.bookingdates.checkin).to.eql('2026-11-01');",
                  "  pm.expect(body.booking.bookingdates.checkout).to.eql('2026-11-05');",
                  "});",
                  "pm.environment.set('bookingid', body.bookingid);"
                ]
              }
            }
          ]
        },
        {
          "name": "API-04 Get the created booking by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/booking/{{bookingid}}",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('All fields match the booking created in API-03', () => {",
                  "  pm.expect(body.firstname).to.eql('QaTest');",
                  "  pm.expect(body.lastname).to.eql('Practice');",
                  "  pm.expect(body.totalprice).to.eql(150);",
                  "  pm.expect(body.depositpaid).to.eql(true);",
                  "  pm.expect(body.bookingdates.checkin).to.eql('2026-11-01');",
                  "  pm.expect(body.bookingdates.checkout).to.eql('2026-11-05');",
                  "  pm.expect(body.additionalneeds).to.eql('Breakfast');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "API-05 Filter bookings by first and last name",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/booking?firstname=QaTest&lastname=Practice",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().map(b => b.bookingid);",
                  "pm.test('Result contains the created booking', () => pm.expect(ids).to.include(Number(pm.environment.get('bookingid'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "API-06 Get a booking that does not exist",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/booking/999999999",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Not documented. Common REST expectation: 404 Not Found.",
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "API-07 Create booking without firstname (negative)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/booking",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lastname\": \"Practice\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": { \"checkin\": \"2026-11-01\", \"checkout\": \"2026-11-05\" }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Not documented. Expectation: a required field is missing, so the API should reject the request with a 4xx client error.",
                  "pm.test('Status is a 4xx client error', () => pm.expect(pm.response.code).to.be.within(400, 499));",
                  "pm.test('Response contains no bookingid', () => pm.expect(pm.response.text()).to.not.include('bookingid'));"
                ]
              }
            }
          ]
        },
        {
          "name": "API-08 Create booking with totalprice as text (negative)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/booking",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"QaTest\",\n  \"lastname\": \"Practice\",\n  \"totalprice\": \"one hundred\",\n  \"depositpaid\": true,\n  \"bookingdates\": { \"checkin\": \"2026-11-01\", \"checkout\": \"2026-11-05\" }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Not documented. totalprice is documented as Number, so text should be rejected with a 4xx client error.",
                  "pm.test('Status is a 4xx client error', () => pm.expect(pm.response.code).to.be.within(400, 499));",
                  "if (pm.response.code === 200) {",
                  "  // If the API accepts the request anyway, check what it stored.",
                  "  pm.test('Stored totalprice is not null', () => pm.expect(pm.response.json().booking.totalprice).to.not.be.null);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "API-09 Create booking with checkout before checkin (negative)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/booking",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"QaTest\",\n  \"lastname\": \"Practice\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": { \"checkin\": \"2026-11-05\", \"checkout\": \"2026-11-01\" }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Not documented. Business-logic expectation: checkout earlier than checkin should be rejected with a 4xx client error.",
                  "pm.test('Status is a 4xx client error', () => pm.expect(pm.response.code).to.be.within(400, 499));"
                ]
              }
            }
          ]
        },
        {
          "name": "API-10 Update booking without a token (negative)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/booking/{{bookingid}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Changed\",\n  \"lastname\": \"Practice\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": { \"checkin\": \"2026-11-01\", \"checkout\": \"2026-11-05\" },\n  \"additionalneeds\": \"Breakfast\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Documented: PUT requires a token or Basic auth. Expectation: 403 Forbidden (the exact code is not documented).",
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "API-11 Delete booking without a token (negative)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/booking/{{bookingid}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Documented: DELETE requires a token or Basic auth. Expectation: 403 Forbidden (the exact code is not documented).",
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Auth, update and delete (needs credentials)",
      "item": [
        {
          "name": "API-12 Create token with valid credentials",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('A non-empty token is returned', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
                  "pm.environment.set('token', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "API-13 Create token with a wrong password (negative)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong-password\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Not documented. Expectation: no token is returned. Record the actual status code.",
                  "pm.test('No token is returned', () => pm.expect(pm.response.text()).to.not.include('token'));"
                ]
              }
            }
          ]
        },
        {
          "name": "API-14 Update booking with a token (PUT)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/booking/{{bookingid}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Updated\",\n  \"lastname\": \"Practice\",\n  \"totalprice\": 200,\n  \"depositpaid\": false,\n  \"bookingdates\": { \"checkin\": \"2026-11-02\", \"checkout\": \"2026-11-06\" },\n  \"additionalneeds\": \"Dinner\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('All fields are updated', () => {",
                  "  pm.expect(body.firstname).to.eql('Updated');",
                  "  pm.expect(body.totalprice).to.eql(200);",
                  "  pm.expect(body.depositpaid).to.eql(false);",
                  "  pm.expect(body.additionalneeds).to.eql('Dinner');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "API-15 Partially update booking with a token (PATCH)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/booking/{{bookingid}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Patched\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Only firstname changed', () => {",
                  "  pm.expect(body.firstname).to.eql('Patched');",
                  "  pm.expect(body.lastname).to.eql('Practice');",
                  "  pm.expect(body.totalprice).to.eql(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "API-16 Delete booking with a token",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/booking/{{bookingid}}",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 (as documented)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "API-17 Get the deleted booking",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/booking/{{bookingid}}",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Expectation: the booking no longer exists.",
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
